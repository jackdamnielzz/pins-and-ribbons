{
  // Type-checks src/core and src/ai without the DOM library, so any use of
  // window, document or other browser globals fails to compile (PLAN 8.1).
  // Standalone on purpose: the JSX settings in tsconfig.json would pull in Preact and the DOM lib.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/core", "src/ai"],
  "exclude": ["src/**/*.test.ts"]
}
